# Sipora Café — client (public) configuration.
# Only EXPO_PUBLIC_* variables are inlined into the app bundle and are
# visible to end users. Never put secrets, DB URLs, JWTs, or API keys here.
# Copy this file to .env and fill in real values (never commit .env).

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=Sipora Café
# Optional — set only when a backend is introduced (out of scope for MVP).
EXPO_PUBLIC_API_URL=