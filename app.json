{
  "expo": {
    "name": "Sipora-Cafee-Demo",
    "slug": "Sipora-Cafee-Demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sipora-cafee-demo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.sipora.cafee.demo"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d2a7b1c9-cb91-4783-bcff-918d843567e6"
      }
    }
  }
}
